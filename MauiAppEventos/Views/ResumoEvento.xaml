<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppEventos.Views.ResumoEvento"
    Title="Resumo do Evento"
    BackgroundColor="#F2F5FA">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="16">

            <Label
                Text="Evento cadastrado!"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#17365D"
                HorizontalOptions="Center"/>

            <Label
                Text="Confira os dados do seu evento:"
                FontSize="15"
                TextColor="#555555"
                HorizontalOptions="Center"/>

            <Frame
                BackgroundColor="White"
                CornerRadius="15"
                Padding="20"
                HasShadow="True">

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="INFORMAÇÕES DO EVENTO"
                        FontAttributes="Bold"
                        FontSize="16"
                        TextColor="#17365D"/>

                    <Label Text="{Binding NomeEvento, StringFormat='Nome: {0}'}"
                           TextColor="#333333"/>

                    <Label Text="{Binding DataInicio, StringFormat='Data de início: {0:dd/MM/yyyy}'}"
                           TextColor="#333333"/>

                    <Label Text="{Binding DataTermino, StringFormat='Data de término: {0:dd/MM/yyyy}'}"
                           TextColor="#333333"/>

                    <Label Text="{Binding DuracaoDias, StringFormat='Duração: {0} dias'}"
                           TextColor="#333333"/>

                    <Label Text="{Binding NumeroParticipantes, StringFormat='Participantes: {0}'}"
                           TextColor="#333333"/>

                    <Label Text="{Binding LocalEvento, StringFormat='Local: {0}'}"
                           TextColor="#333333"/>

                    <Label Text="{Binding CustoPorParticipante, StringFormat='Custo por participante: R$ {0:N2}'}"
                           TextColor="#333333"/>

                    <BoxView HeightRequest="1"
                             Color="#D9E0EA"/>

                    <Label
                        Text="CUSTO TOTAL DO EVENTO"
                        FontAttributes="Bold"
                        FontSize="16"
                        TextColor="#17365D"/>

                    <Label
                        Text="{Binding CustoTotal, StringFormat='R$ {0:N2}'}"
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#16834A"/>

                </VerticalStackLayout>

            </Frame>

            <Button
                Text="VOLTAR AO CADASTRO"
                BackgroundColor="#17365D"
                TextColor="White"
                CornerRadius="12"
                HeightRequest="50"
                Clicked="OnVoltarClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>